# Copy this file to .env and fill in the values. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# URL of the frontend, allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# How many proxies sit in front of the API: 0 locally, set for Render in production.
# Needed so rate limits see each user's real IP, not the proxy's.
TRUST_PROXY=0

# Neon Postgres — Dashboard → Connect
# Pooled connection (host contains -pooler), used by the running app
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection (no -pooler), used only by Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Signs access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different value in every environment.
JWT_ACCESS_SECRET=
# Optional (defaults shown)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google Gemini — https://aistudio.google.com/apikey (free tier, no billing needed)
GEMINI_API_KEY=
# Models get retired; change these if Google's API reports one as unavailable
GEMINI_MODEL=gemini-3.5-flash
# Fallbacks, tried in order (comma-separated). The free tier allows about 20
# requests per day for EACH model, so several fallbacks multiply daily capacity.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-3.8-flash
# 0 turns "thinking" off: faster replies that aren't cut off
GEMINI_THINKING_BUDGET=0

# Total time allowed for one generation, including retry and fallback
AI_TIMEOUT_MS=30000
# AI requests allowed per user per minute (all AI features combined)
AI_RATE_LIMIT_PER_MINUTE=20

# OpenAI (optional alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
