// Database schema. Change it, then run `npm run db:migrate -- --name <change>`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DIRECT_URL") // direct connection, used by migrations
}

enum Role {
  USER
  ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  GENERATED
  EXPORTED
}

enum EntityType {
  PROPOSAL
  COVER_LETTER
  GIG
  PRICING
  REPLY
  INVOICE
  CONTRACT
  CLIENT
}

enum AiFeature {
  PROPOSAL
  COVER_LETTER
  GIG
  PRICING
  REPLY
  CONTRACT
}

// Same values as TONES in @afa/shared
enum WritingTone {
  PROFESSIONAL
  FRIENDLY
  PERSUASIVE
  FORMAL
  CONCISE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  aiCredits       Int       @default(100)
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile                 UserProfile?
  settings                UserSettings?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  clients                 Client[]
  activities              Activity[]
  aiUsage                 AiUsage[]
  proposals               Proposal[]
  coverLetters            CoverLetter[]
  gigDescriptions         GigDescription[]

  @@map("users")
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  title        String?
  bio          String?
  skills       String[]
  hourlyRate   Decimal? @db.Decimal(10, 2)
  portfolioUrl String?
  avatarUrl    String?
  location     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSettings {
  id              String     @id @default(cuid())
  userId          String     @unique
  theme           Theme      @default(SYSTEM)
  language        String     @default("en") // ISO 639-1 code
  currency        String     @default("USD") // ISO 4217 code
  notifyEmail     Boolean    @default(true)
  aiProvider      AiProvider @default(GEMINI)
  encryptedApiKey String? // AES-256-GCM; never returned in full
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// One row per signed-in device. Only the SHA-256 hash of the token is stored.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Archived instead of deleted when invoices or contracts still refer to them
model Client {
  id        String       @id @default(cuid())
  userId    String
  name      String
  email     String?
  company   String?
  phone     String?
  address   String?
  notes     String?
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals Proposal[]

  @@index([userId, status])
  @@map("clients")
}

// Timeline entries. Not linked to the entity on purpose: "Deleted proposal X"
// must outlive the proposal, so the summary is written at the time.
model Activity {
  id         String       @id @default(cuid())
  userId     String
  type       ActivityType
  entityType EntityType
  entityId   String?
  summary    String
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("activities")
}

// One row per AI call: credit accounting, cost tracking and an audit trail
model AiUsage {
  id           String     @id @default(cuid())
  userId       String
  feature      AiFeature
  provider     AiProvider
  model        String
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  creditsUsed  Int        @default(0)
  success      Boolean
  errorCode    String?
  durationMs   Int?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage")
}

// A saved proposal. The inputs are kept so Edit can show them and Regenerate can rerun them.
model Proposal {
  id                 String      @id @default(cuid())
  userId             String
  // Optional link to a saved client; clientName is kept so the text survives if the client is removed
  clientId           String?
  clientName         String
  projectTitle       String
  projectDescription String
  skills             String[]
  budget             String
  timeline           String
  tone               WritingTone
  content            String
  promptVersion      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([clientId])
  @@map("proposals")
}

// A saved cover letter, with the inputs that produced it
model CoverLetter {
  id             String      @id @default(cuid())
  userId         String
  jobTitle       String
  companyName    String
  experience     String
  skills         String[]
  portfolioUrl   String?
  jobDescription String?
  tone           WritingTone
  content        String
  promptVersion  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("cover_letters")
}

model GigDescription {
  id              String          @id @default(cuid())
  userId          String
  category        String
  skills          String[]
  experienceLevel ExperienceLevel
  deliveryDays    Int
  features        String[]
  revisions       Int
  description     String
  seoKeywords     String[]
  // [{ question, answer }], checked with gigContentSchema before saving
  faqs            Json
  promptVersion   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("gig_descriptions")
}
